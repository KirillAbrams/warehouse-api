#!/bin/sh
# Останавливает подготовку при ошибке, чтобы не запускать частично собранное приложение.
set -eu
cd "$(dirname "$0")/.."

# Выбирает установленный способ управления контейнерами.
if docker compose version >/dev/null 2>&1; then
    compose() { docker compose "$@"; }
else
    compose() { docker-compose "$@"; }
fi

# Создаёт местные настройки один раз, сохраняя последующие изменения владельца.
if [ ! -f .env ]; then
    cp .env.example .env
fi

# Заранее готовит свою сеть, в том числе при исчерпании стандартных диапазонов Docker.
./bin/prepare-network

# Заменяет адрес посредника на адрес компьютера, доступный из контейнера.
container_proxy() {
    printf '%s' "$1" | sed -e 's@://127\.0\.0\.1:@://host.docker.internal:@' -e 's@://localhost:@://host.docker.internal:@'
}

task_http_proxy=$(container_proxy "${HTTP_PROXY:-${http_proxy:-}}")
task_https_proxy=$(container_proxy "${HTTPS_PROXY:-${https_proxy:-}}")

# Собирает среду и устанавливает библиотеки строго из сохранённого списка версий.
compose build --build-arg HTTP_PROXY="$task_http_proxy" --build-arg HTTPS_PROXY="$task_https_proxy" app
compose run --rm --no-deps \
    -e HTTP_PROXY="$task_http_proxy" -e HTTPS_PROXY="$task_https_proxy" \
    -e http_proxy="$task_http_proxy" -e https_proxy="$task_https_proxy" \
    app composer install --no-interaction --prefer-dist

# Создаёт ключ приложения только при его отсутствии.
if ! grep -q '^APP_KEY=base64:' .env; then
    compose run --rm --no-deps app php artisan key:generate --force --no-interaction
fi

# Даёт приложению право записывать временные файлы в предназначенные для этого папки.
compose run --rm --no-deps app chmod -R a+rwX storage bootstrap/cache

# Готовит базу и учебные данные, затем ждёт запуска всех служб приложения.
compose up -d postgres redis
compose run --rm app php artisan migrate --force --no-interaction
compose run --rm app php artisan db:seed --force --no-interaction
compose up -d --wait --wait-timeout 60 app api worker scheduler
