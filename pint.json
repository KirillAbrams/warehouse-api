{
    "preset": "laravel",
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "not_operator_with_successor_space": false,
        "single_line_empty_body": false,
        "class_attributes_separation": {
            "elements": {
                "const": "none",
                "method": "one",
                "property": "one",
                "trait_import": "none",
                "case": "none"
            }
        },
        "phpdoc_align": {
            "align": "left",
            "spacing": {
                "param": 1
            }
        },
        "no_superfluous_phpdoc_tags": false,
        "trailing_comma_in_multiline": false,
        "ordered_class_elements": true
    }
}
