# Application name, URL and generated key.
APP_NAME=Warehouse
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8187
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
API_PORT=8187

# Application logging.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Local database connection for demo use.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=warehouse
DB_USERNAME=warehouse
DB_PASSWORD=local-development-only

# Cache, queue and session stores.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array
# Use separate Redis databases for queue and catalogue data.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=warehouse_
REDIS_TIMEOUT=1
REDIS_READ_TIMEOUT=1

# Reservation lifetime in seconds.
RESERVATION_TTL_SECONDS=600
