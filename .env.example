# Название, адрес и ключ приложения. Ключ заполняется при подготовке.
APP_NAME=Warehouse
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8187
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
API_PORT=8187

# Вывод сообщений приложения.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Подключение к местной базе. Этот пароль предназначен для учебного запуска.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=warehouse
DB_USERNAME=warehouse
DB_PASSWORD=local-development-only

# Хранилища временных данных, очереди и сеансов.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array
# Очередь и временный каталог разделены по номерам хранилища.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=warehouse_
REDIS_TIMEOUT=1
REDIS_READ_TIMEOUT=1

# Срок резерва в секундах.
RESERVATION_TTL_SECONDS=600
